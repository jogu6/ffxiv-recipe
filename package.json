{
  "name": "ffxiv-recipe",
  "version": "1.0.0",
  "description": "FFXIVのレシピと必要素材をツリー表示する静的Webアプリです。",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node tools/serve-site.mjs",
    "pipeline:gui": "tauri dev",
    "pipeline:gui:build": "tauri build",
    "check": "npm-run-all check:js check:site check:calculation check:pipeline",
    "check:js": "node --check site/calculation.js && node --check site/app.js && node --check site/sw.js && node --check tools/validate-site.mjs && node --check pipeline/tool/pipeline-tool.mjs && node --check pipeline/gui/main.js",
    "check:calculation": "node --test tests/calculation.test.js",
    "check:pipeline": "node --test tests/pipeline-tool.test.mjs tests/gui-contract.test.mjs",
    "check:site": "node tools/validate-site.mjs",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml,yaml,webmanifest}\"",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml,yaml,webmanifest}\"",
    "lint:md": "markdownlint-cli2",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jogu6/ffxiv-recipe.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jogu6/ffxiv-recipe/issues"
  },
  "homepage": "https://github.com/jogu6/ffxiv-recipe#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2.11.3",
    "markdownlint-cli2": "^0.22.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.4"
  }
}
